{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "plugins": ["import", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "no-debugger": "error",
    "eqeqeq": ["error", "always"],
    "no-unneeded-ternary": "warn",
    "no-else-return": "warn",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "sort-imports": "off",
    "sort-keys": "off",
    "group-exports": "off",
    "filename-case": "off",
    "no-duplicate-imports": "off",
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [".output", ".wxt", "node_modules", "dist"]
}
