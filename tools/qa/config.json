{
  "project": "tab-sorter-stylex",
  "surface": "extension",
  "choice": "agent-browser with Chrome for Testing for fresh unpacked-extension UI smoke; preserve existing unit and regression suites",
  "commands": {
    "dev": {
      "cwd": ".",
      "argv": ["bun", "run", "dev"]
    },
    "build": {
      "cwd": "apps/extension",
      "argv": ["bun", "run", "build"]
    },
    "test": {
      "cwd": ".",
      "argv": ["bun", "run", "test"]
    },
    "harness:check": {
      "argv": ["bun", "--no-env-file", "tools/qa/self-check.mjs"]
    }
  },
  "extension": {
    "directory": "apps/extension/.output/chrome-mv3"
  }
}
