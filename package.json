{
  "name": "tab-sorter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "check-types": "bun run --filter='*' check-types",
    "test": "bun run --filter='*' test",
    "test:coverage": "bun run --filter='*' test:coverage",
    "lint": "bun run --filter='*' lint && bun run lint:boundaries",
    "lint:boundaries": "depcruise apps packages",
    "format": "bun run --filter='*' format",
    "format:check": "bun run --filter='*' format:check",
    "check:doctor": "react-doctor --yes --blocking warning"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rslint/tsgo": "^0.7.3",
    "@tab-sorter/config": "*",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "dependency-cruiser": "^18.5.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react-doctor": "0.9.17",
    "typescript": "next"
  },
  "packageManager": "bun@1.3.14"
}
