{
  "name": "tab-sorter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "check-types": "bun run --filter='*' check-types",
    "test": "bun run --filter='*' test",
    "test:coverage": "bun run --filter='*' test:coverage",
    "lint": "bun run --filter='*' lint",
    "format": "bun run --filter='*' format",
    "format:check": "bun run --filter='*' format:check",
    "check:doctor": "react-doctor --yes --blocking warning"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@rslint/tsgo": "^0.6.2",
    "@tab-sorter/config": "*",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "react-doctor": "0.5.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
