{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "Tab Sorter — sort, extract, and export your browser tabs",
  "type": "module",
  "scripts": {
    "dev": "bunx wxt --port 5555",
    "dev:firefox": "bunx wxt -b firefox",
    "build": "bunx wxt build",
    "build:firefox": "bunx wxt build -b firefox",
    "zip": "bunx wxt zip",
    "zip:firefox": "bunx wxt zip -b firefox",
    "check-types": "bunx tsgo -config tsconfig.json",
    "postinstall": "bunx wxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint -c .oxlintrc.json .",
    "format": "oxfmt --write '**/*.ts' '**/*.tsx'",
    "format:check": "oxfmt --check '**/*.ts' '**/*.tsx'"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@tab-sorter/core": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rslint/tsgo": "^0.7.3",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tab-sorter/config": "*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "browserslist": "^4.29.3",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "next",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
