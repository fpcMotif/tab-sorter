{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "Tab Sorter — sort, extract, and export your browser tabs",
  "type": "module",
  "scripts": {
    "dev": "bun x wxt --port 5555",
    "dev:firefox": "bun x wxt -b firefox",
    "build": "bun x wxt build",
    "build:firefox": "bun x wxt build -b firefox",
    "zip": "bun x wxt zip",
    "zip:firefox": "bun x wxt zip -b firefox",
    "check-types": "bun x tsgo -config tsconfig.json",
    "postinstall": "bun x wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c .oxlintrc.json .",
    "format": "oxfmt --write '**/*.ts' '**/*.tsx'",
    "format:check": "oxfmt --check '**/*.ts' '**/*.tsx'"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@rslint/tsgo": "^0.6.2",
    "@tab-sorter/config": "*",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@webext-core/fake-browser": "^1.3.2",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wxt": "^0.20.26"
  }
}
